# Checks the layering rules of docs/dev/architecture.md (the tables between the layering markers):
#  - every source file under src/lib and src/apps belongs to a component,
#  - a file includes headers only from its own component and the components it depends on (transitively),
#  - the component graph has no cycles,
#  - each component has a CMake target that links exactly the components it depends on and builds only
#    the component's own sources (when LINKS_FILE is given).
# A quoted include is resolved against the including file's directory first, then against src/lib.
#
# Test mode:      cmake -DSOURCE_DIR=<repo> [-DLINKS_FILE=<file>] -P cmake/CheckLayering.cmake
# Configure mode: include() it, then call layering_write_links(<file> [<optional component>...]) to
#                 record the target links; optional components may have no target on this platform.

set(LAYERING_DOC "${CMAKE_CURRENT_LIST_DIR}/../docs/dev/architecture.md")
set(LAYERING_SOURCE_PATTERN "\\.(h|hpp|c|cpp|m|mm)$")

# Sets LAYERING_COMPONENTS, LAYERING_PREFIXES ("prefix=component"), LAYERING_EXCEPTIONS ("file>include"),
# and LAYERING_DEPS_<component> in the caller's scope.
macro(layering_parse)
  file(READ "${LAYERING_DOC}" _doc)
  string(REPLACE ";" "," _doc "${_doc}")
  set(LAYERING_COMPONENTS "")
  set(LAYERING_PREFIXES "")
  set(LAYERING_EXCEPTIONS "")
  foreach(_section IN ITEMS components exceptions)
    string(REGEX MATCH "<!-- layering:${_section}:begin -->(.*)<!-- layering:${_section}:end -->" _ "${_doc}")
    string(REPLACE "\n" ";" _lines "${CMAKE_MATCH_1}")
    foreach(_line IN LISTS _lines)
      if(NOT _line MATCHES "^\\|.*`")
        continue()
      endif()
      # one entry per table cell: the cell's backticked words joined by commas, or "-"
      string(REPLACE "|" ";" _cells "${_line}")
      set(_ticks "")
      foreach(_cell IN LISTS _cells)
        string(REGEX MATCHALL "`[^`]+`" _m "${_cell}")
        string(REPLACE "`" "" _m "${_m}")
        string(REPLACE ";" "," _m "${_m}")
        if(_m STREQUAL "")
          set(_m "-")
        endif()
        list(APPEND _ticks "${_m}")
      endforeach()
      if(_section STREQUAL "components")
        # | layer | component | source prefixes | depends on | contents |
        list(GET _ticks 2 _name)
        list(GET _ticks 3 _sources)
        list(GET _ticks 4 _deps)
        list(APPEND LAYERING_COMPONENTS "${_name}")
        string(REPLACE "," ";" LAYERING_DEPS_${_name} "${_deps}")
        list(REMOVE_ITEM LAYERING_DEPS_${_name} "-")
        string(REPLACE "," ";" _sources "${_sources}")
        foreach(_prefix IN LISTS _sources)
          list(APPEND LAYERING_PREFIXES "${_prefix}=${_name}")
        endforeach()
      else()
        # | file | includes | why |
        list(GET _ticks 1 _file)
        list(GET _ticks 2 _includes)
        string(REPLACE "," ";" _includes "${_includes}")
        foreach(_include IN LISTS _includes)
          list(APPEND LAYERING_EXCEPTIONS "${_file}>${_include}")
        endforeach()
      endif()
    endforeach()
  endforeach()
endmacro()

# Longest matching prefix wins, so a file-name prefix can carve files out of a directory's component.
function(component_of path out)
  if(DEFINED CACHED_${path})
    set(${out} "${CACHED_${path}}" PARENT_SCOPE)
    return()
  endif()
  set(best "")
  set(bestLength 0)
  foreach(entry IN LISTS LAYERING_PREFIXES)
    string(REGEX MATCH "^(.*)=(.*)$" _ "${entry}")
    string(LENGTH "${CMAKE_MATCH_1}" length)
    string(SUBSTRING "${path}" 0 ${length} head)
    if(head STREQUAL CMAKE_MATCH_1 AND length GREATER bestLength)
      set(best "${CMAKE_MATCH_2}")
      set(bestLength ${length})
    endif()
  endforeach()
  set(CACHED_${path} "${best}" PARENT_SCOPE)
  set(${out} "${best}" PARENT_SCOPE)
endfunction()

function(layering_write_links file)
  layering_parse()
  set(content "")
  foreach(component IN LISTS LAYERING_COMPONENTS)
    if(NOT TARGET ${component})
      if(NOT component IN_LIST ARGN)
        string(APPEND content "list(APPEND TARGET_ERRORS \"component ${component} has no CMake target\")\n")
      endif()
      continue()
    endif()
    get_target_property(links ${component} LINK_LIBRARIES)
    set(linked "")
    foreach(link IN LISTS links)
      if(link IN_LIST LAYERING_COMPONENTS)
        list(APPEND linked ${link})
      endif()
    endforeach()
    string(APPEND content "set(LINKS_${component} \"${linked}\")\nlist(APPEND LINKED_COMPONENTS ${component})\n")
    get_target_property(sources ${component} SOURCES)
    get_target_property(sourceDir ${component} SOURCE_DIR)
    foreach(source IN LISTS sources)
      if(source MATCHES "\\$<" OR NOT source MATCHES "${LAYERING_SOURCE_PATTERN}")
        continue()
      endif()
      cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${sourceDir}" NORMALIZE)
      file(RELATIVE_PATH source "${CMAKE_SOURCE_DIR}/src" "${source}")
      if(source MATCHES "^\\.\\./")
        continue()
      endif()
      component_of("${source}" owner)
      if(NOT owner STREQUAL component)
        string(APPEND content "list(APPEND TARGET_ERRORS \"target ${component} builds src/${source}, which the table puts in '${owner}'\")\n")
      endif()
    endforeach()
  endforeach()
  file(WRITE "${file}" "${content}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LAYERING_DOC}")
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  return()
endif()
cmake_minimum_required(VERSION 3.24)

set(errors "")
layering_parse()
if(NOT LAYERING_COMPONENTS)
  message(FATAL_ERROR "no layering table found in ${LAYERING_DOC}")
endif()

foreach(component IN LISTS LAYERING_COMPONENTS)
  set(todo ${LAYERING_DEPS_${component}})
  set(allowed "")
  while(todo)
    list(POP_FRONT todo dep)
    if(NOT dep IN_LIST LAYERING_COMPONENTS)
      list(APPEND errors "${component} depends on unknown component ${dep}")
    elseif(NOT dep IN_LIST allowed)
      list(APPEND allowed ${dep})
      list(APPEND todo ${LAYERING_DEPS_${dep}})
    endif()
  endwhile()
  if(component IN_LIST allowed)
    list(APPEND errors "${component} depends on itself through a cycle")
  endif()
  set(ALLOWED_${component} ${allowed})
endforeach()


set(src "${SOURCE_DIR}/src")
file(GLOB libDirs LIST_DIRECTORIES true RELATIVE "${src}/lib" "${src}/lib/*")
file(GLOB_RECURSE files RELATIVE "${src}" "${src}/lib/*" "${src}/apps/*")
list(FILTER files INCLUDE REGEX "${LAYERING_SOURCE_PATTERN}")
set(usedExceptions "")
set(includePattern "^[ \t]*#[ \t]*(include|import)[ \t]*([<\"])([^\">]+)[\">]")

foreach(file IN LISTS files)
  component_of("${file}" own)
  if(own STREQUAL "")
    list(APPEND errors "src/${file} is not in any component")
    continue()
  endif()
  cmake_path(GET file PARENT_PATH fileDir)
  file(STRINGS "${src}/${file}" includes REGEX "${includePattern}")
  foreach(include IN LISTS includes)
    string(REGEX MATCH "${includePattern}" _ "${include}")
    set(quote "${CMAKE_MATCH_2}")
    set(name "${CMAKE_MATCH_3}")
    if(quote STREQUAL "\"" AND EXISTS "${src}/${fileDir}/${name}")
      set(path "${fileDir}/${name}")
      cmake_path(NORMAL_PATH path)
    elseif(name MATCHES "^([A-Za-z0-9_]+)/" AND CMAKE_MATCH_1 IN_LIST libDirs)
      set(path "lib/${name}")
    else()
      continue()
    endif()
    component_of("${path}" used)
    if(used STREQUAL "" OR used STREQUAL own OR used IN_LIST ALLOWED_${own})
      continue()
    endif()
    string(REGEX REPLACE "^lib/" "" header "${path}")
    if("${file}>${header}" IN_LIST LAYERING_EXCEPTIONS)
      list(APPEND usedExceptions "${file}>${header}")
      continue()
    endif()
    list(APPEND errors "src/${file} (${own}) includes ${header} (${used})")
  endforeach()
endforeach()

foreach(exception IN LISTS LAYERING_EXCEPTIONS)
  if(NOT exception IN_LIST usedExceptions)
    string(REPLACE ">" " -> " exception "${exception}")
    list(APPEND errors "stale exception, remove it from the table: ${exception}")
  endif()
endforeach()

if(DEFINED LINKS_FILE)
  include("${LINKS_FILE}")
  list(APPEND errors ${TARGET_ERRORS})
  foreach(component IN LISTS LINKED_COMPONENTS)
    set(expected ${LAYERING_DEPS_${component}})
    set(actual ${LINKS_${component}})
    list(REMOVE_DUPLICATES actual)
    list(SORT expected)
    list(SORT actual)
    if(NOT "${expected}" STREQUAL "${actual}")
      list(JOIN actual " " actual)
      list(JOIN expected " " expected)
      list(APPEND errors "target ${component} links components '${actual}' but the table says '${expected}'")
    endif()
  endforeach()
endif()

if(errors)
  list(JOIN errors "\n  " text)
  message(FATAL_ERROR "Layering violations (see ${LAYERING_DOC}):\n  ${text}")
endif()
list(LENGTH files count)
message(STATUS "layering ok: ${count} files")
